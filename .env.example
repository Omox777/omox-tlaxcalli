GEMINI_API_KEY=pega_aqui_tu_clave
GEMINI_MODEL=gemini-3.8-flash

# Voz de Omox (ElevenLabs). Sin clave, Omox usa la voz del navegador.
ELEVENLABS_API_KEY=pega_aqui_tu_clave
# Elige una voz con:  npm run voces
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# eleven_flash_v2_5 = rápida y gasta la mitad de créditos · eleven_multilingual_v2 = más calidad
ELEVENLABS_MODEL=eleven_flash_v2_5
# Ajustes de voz (0 a 1). Estabilidad más baja = más expresiva.
ELEVENLABS_STABILITY=0.45
ELEVENLABS_SIMILARITY=0.8
ELEVENLABS_STYLE=0.25
# Velocidad: 0.7 lenta … 1 normal … 1.2 rápida
ELEVENLABS_SPEED=1
